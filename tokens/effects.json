          "targetVariableSetName": "Basic Numbers"
        }
      }
    },
    "rounding-08": {
      "$type": "number",
      "$value": 8,
      "$description": "For grouped content and mid-sized surfaces — cards, tooltips, smaller modals, and panels. Clearly rounded but still restrained.",
