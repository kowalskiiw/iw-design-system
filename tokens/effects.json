          "targetVariableId": "VariableID:f5e3e7a7b1c966bad570e0fc99aea8033ed79b30/-1:-1",
          "targetVariableName": "2",
          "targetVariableSetId": "VariableCollectionId:5ef4690b4c8b8ba3a758d96e31be191b86158908/-1:-1",
          "targetVariableSetName": "Basic Numbers"
        }
      }
    },
    "rounding-04": {
      "$type": "number",
      "$value": 4,
      "$description": "The default radius for most interactive components: buttons, inputs, dropdowns, and selects. The everyday workhorse when in doubt.",
