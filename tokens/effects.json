{
  "Roundings": {
    "rounding-02": {
      "$type": "number",
      "$value": 2,
      "$description": "The subtlest rounding. Takes the hard edge off small, dense elements — input fields, tags, checkboxes, badges — without looking visibly rounded.",
      "$extensions": {
        "com.figma.variableId": "VariableID:32878:7521",
        "com.figma.scopes": [
          "CORNER_RADIUS",
          "FONT_VARIATIONS"
